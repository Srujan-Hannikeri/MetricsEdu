{
  "version": 2,
  "installCommand": "cd server && npm install --no-audit && cd ../client && npm install --no-audit --legacy-peer-deps",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__metricsedu_route=:path*" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
